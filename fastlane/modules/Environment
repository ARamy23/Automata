require 'colored'
require 'yaml'
require 'json'
require 'dotenv'

platform :ios do
  desc "Sets up Environment Variables"
  lane :setup_environment do
    UI.header "Setting up Environment Variables..."

    if ENV["CI"]
      UI.header "🚀 CI environment detected. Setting up CI environment variables..."
      UI.message "🚀 Setting Up CI Environment"
      Dotenv.load "configs/ci/.env.default.ci.match"
      Dotenv.load "configs/ci/.env.default.ci.settings"
      UI.message "🔑 Setting up CI Certs & Profiles..."

      setup_ci
    else 
      UI.message "🚀 CI environment not detected. Setting up default environment variables..."
    end

    if File.exist?("configs/default/.env.default.auth") == false
      UI.crash! "💥 Whoops, looks like you forgot to set up your .env.default.auth file, "
    end

    Dotenv.load "configs/default/.env.default.auth"
    Dotenv.load "configs/default/.env.default.deliver"
    Dotenv.load "configs/default/.env.default.metadata"
    Dotenv.load "configs/default/.env.default.project"
    
    UI.success "✅ Environment Variables are set up successfully!"
  end

  lane :configure_release_environment_variables do |options|
    UI.message "Configuring release environment variables"
    env = options[:env].to_s
    ENV['SELECTED_ENV'] = env.upcase

    case ENV['SELECTED_ENV']
    when "ALPHA"
      ENV["SELECTED_BUNDLE_ID"] = "com.automata.automata.example.alpha"
    when "BETA"
      ENV["SELECTED_BUNDLE_ID"] = "com.automata.automata.example.beta"
    when "RELEASE"
      ENV["SELECTED_BUNDLE_ID"] = "com.automata.automata.example"
    else
      UI.user_error! "Whoops, looks like you picked a wrong environment this time, its ok, happens to the best of us, now re-run me again 😛"
    end
  end
  
  desc "Generates Project + Secrets + Makes sure Mise & Tuist are corectly configured"
  lane :generate_project do
    sh('rake setup_secrets')
    sh("mise install tuist@4.27.0")
    sh("mise use tuist@4.27.0")
    sh("tuist install -p ..")
    sh("tuist cache -p ..")

    UI.message "Verifying that generation was successful..."
    if File.exist?("../#{ENV['PROJECT']}") == false
      UI.crash! "💥 Whoops, looks like you forgot to generate your project file, "
    else 
      UI.success "✅ Project file generated successfully!"
    end

    UI.message "Printing out the contents of the parent directory..."
  end

  desc "Prepare .env file for GitHub Actions CI by extracting certificates and profiles directly from match repo"
  lane :prepare_ci_certs_profiles do
      Dotenv.load "configs/default/.env.default.auth"
      Dotenv.load "configs/ci/.env.default.ci.settings"

      if File.exist?("configs/ci/.env.default.ci.match") == false
        UI.crash! "💥 Whoops, looks like you forgot to set up your .env.default.ci.match file, "
      end

      Dotenv.load "configs/ci/.env.default.ci.match"
      # Load repository URL and encryption password from environment variables
      match_repo_url = ENV["MATCH_GIT_URL"]
      match_repo_path = "./match_repo"  # Temporary directory to clone the match repo

      # Clone the match repository
      sh("git clone #{match_repo_url} #{match_repo_path}")

      # Locate encrypted .p12 certificate and provisioning profile in the cloned repo
      cert_path = Dir["#{match_repo_path}/certs/distribution/*.p12"].first
      profile_path = Dir["#{match_repo_path}/profiles/appstore/*.mobileprovision"].first

      # Ensure the files were downloaded and located correctly
      if cert_path.nil? || profile_path.nil?
        UI.user_error!("Could not locate certificate or provisioning profile in the match repository.")
      end

      # Convert files directly to Base64 format
      cert_base64 = `base64 -i "#{cert_path}"`.strip
      profile_base64 = `base64 -i "#{profile_path}"`.strip

      # Set passwords for keychain and .p12 file
      p12_password = ENV["MATCH_PASSWORD"] || "your_p12_password"
      keychain_password = ENV["KEYCHAIN_PASSWORD"] || "your_keychain_password"

      # Prepare .env file content
      env_content = <<~ENV
        # Environment variables for CI/CD pipeline with match repo secrets
        BUILD_CERTIFICATE_BASE64="#{cert_base64}"
        P12_PASSWORD="#{p12_password}"
        BUILD_PROVISION_PROFILE_BASE64="#{profile_base64}"
        KEYCHAIN_PASSWORD="#{keychain_password}"
      ENV

      # Write the .env file to the specified path
      File.write("configs/ci/.env.default.ci.match", env_content)
      UI.success(".env file generated at 'fastlane/configs/ci/.env.default.ci.match' with required secrets for CI.")

      # Clean up cloned repository
      sh("rm -rf #{match_repo_path}")

    end

  desc "Setup Apple certificate and provisioning profile for CI/CD"
  lane :ci_import_certs_profiles_locally do
      # Load environment variables from .env file if needed
      Dotenv.load "configs/ci/.env.default.ci.match"
      # Load repository URL and encryption password from environment variables
      match_repo_url = ENV["MATCH_GIT_URL"]
      match_repo_path = "./match_repo"  # Temporary directory to clone the match repo

      # Clone the match repository
      sh("git clone #{match_repo_url} #{match_repo_path}")

      # Define paths for the temporary certificate, provisioning profile, and keychain
      certificate_path_folder = "#{match_repo_path}/certs/distribution"

      sh("ls #{certificate_path_folder}")
      sh("ls #{match_repo_path}/profiles/appstore")
      # first file within certificate_path_folder which ends with .p12
      certificate_path = "#{certificate_path_folder}/C8Y6T24ZH3.p12"
      # first file within provisioning_profile_path_folder which matches the selected bundle id
      provisioning_profile_path = "#{match_repo_path}/profiles/appstore/AppStore_#{ENV['SELECTED_BUNDLE_ID']}.mobileprovision"

      # Create and configure a temporary keychain
      keychain_password = ENV["KEYCHAIN_PASSWORD"]
      p12_password = ENV["P12_PASSWORD"]


      import_certificate(
        certificate_path: certificate_path, 
        certificate_password: p12_password,
        keychain_name: 'fastlane_tmp_keychain',
        keychain_password: keychain_password
      )

      install_provisioning_profile(
        path: provisioning_profile_path
      )

      # Copy the provisioning profile to the necessary location
      profiles_dir = File.expand_path("~/Library/MobileDevice/Provisioning Profiles")
      FileUtils.mkdir_p(profiles_dir)
      FileUtils.cp(provisioning_profile_path, profiles_dir)

      # Clean up temporary files
      UI.success("Code signing setup completed successfully.")
    end
end